# Mistral is the default LLM backend for the local Next.js pipeline.
MISTRAL_API_KEYS="key_one,key_two"
MISTRAL_API_KEY=""
MANIMATE_MODEL="mistral-large-2512"
MANIMATE_MODEL_PROVIDER="mistralai"

# OpenAI Keys (comma-separated list for rotation, or single key)
OPENAI_API_KEYS="key_one,key_two"
OPENAI_API_KEY=""

# Anthropic Keys (comma-separated list for rotation, or single key)
ANTHROPIC_API_KEYS="key_one,key_two"
ANTHROPIC_API_KEY=""

# Google Gemini Keys (comma-separated list for rotation, or single key)
GOOGLE_API_KEYS="key_one,key_two"
GOOGLE_API_KEY=""

# Python executable with Manim Community installed.
# IMPORTANT Replace with your own venv
MANIM_PYTHON="E:\\programming\\manimate-uni\\manim-env\\Scripts\\python.exe"
RENDER_TIMEOUT_SECONDS="120"
MAX_CORRECTION_ATTEMPTS="3"
MAX_CONCURRENT_JOBS="1"

# Optional web grounding.
MANIMATE_WEBSEARCH="1"
TAVILY_API_KEY=""
TAVILY_MAX_RESULTS="5"
TAVILY_SEARCH_DEPTH="advanced"

# Kokoro JS TTS.
KOKORO_VOICE="af_heart"
KOKORO_DTYPE="q8"
KOKORO_DEVICE="cpu"

# Optional ffmpeg override. Defaults to "ffmpeg" on PATH.
FFMPEG_PATH="ffmpeg"
