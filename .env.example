# ─── Supabase ────────────────────────────────────────────────────────
# Project URL and keys from Supabase → Project Settings → API.
# NEXT_PUBLIC_* values are inlined into the client bundle AT BUILD TIME, so they
# must also be present when `next build` / `docker build` runs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="generations"

# ─── LLM providers ───────────────────────────────────────────────────
# Mistral is the default backend. Comma-separated *_API_KEYS lists are rotated
# round-robin; a single *_API_KEY also works.
MISTRAL_API_KEYS="key_one,key_two"
MISTRAL_API_KEY=""
MANIMATE_MODEL="mistral-large-2512"
MANIMATE_MODEL_PROVIDER="mistralai"

OPENAI_API_KEYS="key_one,key_two"
OPENAI_API_KEY=""

ANTHROPIC_API_KEYS="key_one,key_two"
ANTHROPIC_API_KEY=""

GOOGLE_API_KEYS="key_one,key_two"
GOOGLE_API_KEY=""

# ─── Rendering ───────────────────────────────────────────────────────
# Python interpreter with Manim Community installed.
# In the Docker image this is /opt/manim-env/bin/python.
# Locally, point it at your own venv. Use forward slashes on Windows too --
# backslashes must be doubled in a .env file and a single "\" silently breaks:
#   Windows: MANIM_PYTHON="C:/path/to/manim-env/Scripts/python.exe"
#   POSIX:   MANIM_PYTHON="/path/to/manim-env/bin/python"
MANIM_PYTHON="/opt/manim-env/bin/python"

# -ql (480p15) | -qm (720p30) | -qh (1080p60)
# -qh renders ~4x slower and produces files past Supabase Storage's default
# 50 MB per-object limit, so deployments default to -qm.
MANIM_QUALITY="-qm"

# Scratch space for renders. Disposable — only the final video and the generated
# Python are uploaded to Supabase Storage.
MANIMATE_WORK_DIR="/var/tmp/manimate"

RENDER_TIMEOUT_SECONDS="120"
MAX_CORRECTION_ATTEMPTS="3"
MAX_CONCURRENT_JOBS="1"
LLM_TIMEOUT_SECONDS="180"
LLM_MAX_RETRIES="4"

# ─── Optional web grounding ──────────────────────────────────────────
MANIMATE_WEBSEARCH="1"
TAVILY_API_KEY=""
TAVILY_MAX_RESULTS="5"
TAVILY_SEARCH_DEPTH="advanced"

# ─── Kokoro JS TTS ───────────────────────────────────────────────────
KOKORO_VOICE="af_heart"
KOKORO_DTYPE="q8"
KOKORO_DEVICE="cpu"
# Where the ~300MB ONNX weights are cached.
HF_HOME="/opt/hf-cache"

# ─── ffmpeg ──────────────────────────────────────────────────────────
# Default to the binaries on PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
FFMPEG_TIMEOUT_SECONDS="900"
