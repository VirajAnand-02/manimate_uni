# ─── Supabase ────────────────────────────────────────────────────────
# Project URL and keys from Supabase → Project Settings → API.
# NEXT_PUBLIC_* values are inlined into the client bundle AT BUILD TIME, so they
# must also be present when `next build` / `docker build` runs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="generations"

# ─── LLM providers ───────────────────────────────────────────────────
# Mistral is the default backend. Comma-separated *_API_KEYS lists are rotated
# round-robin; a single *_API_KEY also works.
MISTRAL_API_KEYS="key_one,key_two"
MISTRAL_API_KEY=""
MANIMATE_MODEL="mistral-large-2512"
MANIMATE_MODEL_PROVIDER="mistralai"

OPENAI_API_KEYS="key_one,key_two"
OPENAI_API_KEY=""

ANTHROPIC_API_KEYS="key_one,key_two"
ANTHROPIC_API_KEY=""

GOOGLE_API_KEYS="key_one,key_two"
GOOGLE_API_KEY=""

# Groq. Note that several Groq model ids contain a slash
# (e.g. "openai/gpt-oss-120b") -- that is part of the model name, not the
# provider/model override syntax. Set MANIMATE_MODEL_PROVIDER="groq" alongside.
GROQ_API_KEYS="key_one,key_two"
GROQ_API_KEY=""

# OpenRouter. One key fronting 400+ models from every major lab. Model ids are
# always "vendor/model" (e.g. "anthropic/claude-sonnet-5") -- that slash is part
# of the model name, not the provider/model override syntax, so pair it with
# MANIMATE_MODEL_PROVIDER="openrouter". Browse ids at openrouter.ai/models.
OPENROUTER_API_KEYS="key_one,key_two"
OPENROUTER_API_KEY=""
# Optional attribution -- OpenRouter credits traffic to your app on its public
# leaderboards. Both are safe to leave blank.
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME=""

# NVIDIA NIM. Key from build.nvidia.com (starts "nvapi-"). Model ids are
# "vendor/model" (e.g. "nvidia/llama-3.1-nemotron-70b-instruct"), so pair with
# MANIMATE_MODEL_PROVIDER="nvidia". Browse the hosted catalogue at
# https://integrate.api.nvidia.com/v1/models -- it needs no auth to read.
# Note that NIM gates models per account: a model can be in that catalogue and
# still answer "Not found for account", so verify before relying on one.
NVIDIA_API_KEYS="key_one,key_two"
NVIDIA_API_KEY=""
# Point this at your own NIM container to self-host instead of using NVIDIA's
# hosted endpoint. Defaults to https://integrate.api.nvidia.com/v1
NVIDIA_NIM_BASE_URL=""

# ─── Rendering ───────────────────────────────────────────────────────
# Python interpreter with Manim Community installed.
# In the Docker image this is /opt/manim-env/bin/python.
# Locally, point it at your own venv. Use forward slashes on Windows too --
# backslashes must be doubled in a .env file and a single "\" silently breaks:
#   Windows: MANIM_PYTHON="C:/path/to/manim-env/Scripts/python.exe"
#   POSIX:   MANIM_PYTHON="/path/to/manim-env/bin/python"
MANIM_PYTHON="/opt/manim-env/bin/python"

# -ql (480p15) | -qm (720p30) | -qh (1080p60)
# -qh renders ~4x slower and produces files past Supabase Storage's default
# 50 MB per-object limit, so deployments default to -qm.
MANIM_QUALITY="-qm"

# Scratch space for renders. Disposable — only the final video and the generated
# Python are uploaded to Supabase Storage.
MANIMATE_WORK_DIR="/var/tmp/manimate"

# Per-scene render budget. A batched module gets this much per scene it contains.
# Generous on purpose: a timeout does not merely lose the render, it burns a
# correction attempt, which costs an LLM call and another render.
RENDER_TIMEOUT_SECONDS="180"
MAX_CORRECTION_ATTEMPTS="3"

# How many generations may run at once. The queue is in-process, so this is per
# container -- see the single-instance requirement in the README.
MAX_CONCURRENT_JOBS="1"

LLM_TIMEOUT_SECONDS="180"
LLM_MAX_RETRIES="4"

# --- Concurrency -----------------------------------------------------
# Scenes of a module render in one Manim process; modules render in parallel.
# Cairo is single-threaded, so this scales with cores. Defaults to cpus-1,
# capped at 4. Each concurrent render holds a few hundred MB.
MANIM_RENDER_CONCURRENCY=""

# Parallel LLM calls (one per module during code generation). Every provider
# rate-limits on tokens per minute, so raise this only alongside a multi-key
# *_API_KEYS rotation or a paid tier. Default 2.
LLM_CONCURRENCY=""

# Parallel Kokoro synthesis and ffmpeg muxing. Competes with Manim for cores.
# Default 2.
TTS_CONCURRENCY=""

# ─── Optional web grounding ──────────────────────────────────────────
MANIMATE_WEBSEARCH="1"
TAVILY_API_KEY=""
TAVILY_MAX_RESULTS="5"
TAVILY_SEARCH_DEPTH="advanced"

# ─── Kokoro JS TTS ───────────────────────────────────────────────────
KOKORO_VOICE="af_heart"
KOKORO_DTYPE="q8"
KOKORO_DEVICE="cpu"
# Where the ~300MB ONNX weights are cached.
HF_HOME="/opt/hf-cache"

# ─── ffmpeg ──────────────────────────────────────────────────────────
# Default to the binaries on PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
FFMPEG_TIMEOUT_SECONDS="900"

# x264 preset for the one path that re-encodes video: padding a scene's tail when
# its voiceover runs longer than the animation. ffmpeg's own default is `medium`.
FFMPEG_X264_PRESET="veryfast"
